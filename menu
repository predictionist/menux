-- ============================================================
-- HELPERS
-- ============================================================
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end

-- colour is a theme key ("BoxStroke", "Border") or a fixed Color3
local function stroke(parent, c)
    local st = new("UIStroke", { Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, parent)
    if type(c) == "string" then bindKey(st, "Color", c) else st.Color = c end
    return st
end

local function fadeStroke(parent)
    local st = stroke(parent, "Border")
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0.00, 0.00),
            NumberSequenceKeypoint.new(0.13, 0.00),
            NumberSequenceKeypoint.new(0.60, 0.50),
            NumberSequenceKeypoint.new(1.00, 0.95),
        }),
    }, st)
    return st
end

local function textStroke(textObj)
    return new("UIStroke", {
        Color = BLACK, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
    }, textObj)
end

-- colorKey: theme key for the text colour (default "Text"); false = the widget colours it itself
local function label(parent, text, x, y, w, h, align, colorKey)
    local l = new("TextLabel", {
        FontFace = Font_Main, Text = text, TextSize = TEXT_SIZE, TextColor3 = C.Text,
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.new(0, s(x), 0, s(y)), Size = UDim2.new(0, s(w), 0, s(h)),
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
    textStroke(l)
    if colorKey ~= false then bindKey(l, "TextColor3", colorKey or "Text") end
    return l
end

local function gradient(parent, topKey, bottomKey)
    local g = new("UIGradient", { Rotation = 90 }, parent)
    onTheme(function()
        g.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, C[topKey]),
            ColorSequenceKeypoint.new(1, C[bottomKey]),
        })
    end)
    return g
end

local function tween(obj, props, t)
    TweenService:Create(obj, TweenInfo.new(t or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function isPress(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

-- Pointer position in the same space as AbsolutePosition. Depending on the executor GUI
-- space is window space or window space minus the top-bar inset; every press on a short
-- object (swatch, title bar) calibrates MouseDY, so nothing is assumed.
local MouseDY = 0

local function rawPointer(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        return input.Position.X, input.Position.Y + GuiService:GetGuiInset().Y
    end
    local m = UserInputService:GetMouseLocation()
    return m.X, m.Y
end

local function pointer(input)
    local x, y = rawPointer(input)
    return x, y - MouseDY
end

local function calibrate(obj, input)
    local inset = GuiService:GetGuiInset().Y
    if inset <= 0 or obj.AbsoluteSize.Y >= inset then return end
    local _, y = rawPointer(input)
    local top, bottom = obj.AbsolutePosition.Y, obj.AbsolutePosition.Y + obj.AbsoluteSize.Y
    if y >= top and y <= bottom then
        MouseDY = 0
    elseif y - inset >= top and y - inset <= bottom then
        MouseDY = inset
    end
end

-- dark 1px-outlined box. bgKey: theme key for the fill (default "BoxOff"), false = widget handles it
local function darkBox(parent, x, y, w, h, class, z, bgKey)
    local f = new(class or "Frame", {
        Position = UDim2.new(0, s(x), 0, s(y)), Size = UDim2.new(0, s(w), 0, s(h)),
        BackgroundColor3 = C.BoxOff, BorderSizePixel = 0, ZIndex = z or 1,
    }, parent)
    if class == "TextButton" then
        f.Text = ""
        f.AutoButtonColor = false
    end
    if bgKey ~= false then bindKey(f, "BackgroundColor3", bgKey or "BoxOff") end
    stroke(f, "BoxStroke")
    return f
end

local function makePanel(parent, x, y, w, h)
    local p = new("Frame", {
        Position = UDim2.new(0, s(x), 0, s(y)), Size = UDim2.new(0, s(w), 0, s(h)),
        BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, parent)
    gradient(p, "PanelTop", "PanelBot")
    fadeStroke(p)
    local line = new("Frame", {
        Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, ZIndex = 2,
    }, p)
    bindKey(line, "BackgroundColor3", "Accent")
    return p
end

local function register(flag, obj)
    Options[flag] = obj
    return obj
end

-- ============================================================
-- POPUP MANAGER (one popup open at a time; click outside / Escape closes it)
-- ============================================================
local Active = nil

local function closeActive()
    if Active then
        local a = Active
        Active = nil
        a.close()
    end
end

local function setActive(handle)
    if Active and Active ~= handle then closeActive() end
    Active = handle
end

-- clicks on anything registered with claim() count as "inside" the popup
local function claim(obj, handle)
    obj.InputBegan:Connect(function(input)
        if isPress(input) then handle.stamp = os.clock() end
    end)
end

local function startPopupWatcher()
    track(UserInputService.InputBegan:Connect(function(input)
        if not Active then return end
        if input.KeyCode == Enum.KeyCode.Escape then
            closeActive()
        elseif isPress(input) then
            local a, t0 = Active, os.clock()
            task.defer(function()
                if Active == a and not (a.stamp and a.stamp >= t0 - 0.1) then closeActive() end
            end)
        end
    end))
end

-- white pixel arrow: set(true) = up (closed), set(false) = down (open)
local function makeArrow(parent)
    local widths, rows = { 9, 7, 5, 3, 1 }, {}
    for i, wpx in ipairs(widths) do
        rows[i] = new("Frame", {
            Size = UDim2.new(0, wpx, 0, 1), AnchorPoint = Vector2.new(0.5, 0),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 2,
        }, parent)
    end
    return function(up)
        for i, r in ipairs(rows) do
            local line = up and (#widths + 1 - i) or i
            r.Position = UDim2.new(1, -s(12), 0.5, line - 3)
        end
    end
end

-- ============================================================
-- WIDGET BUILDERS  (o.X / o.Y / o.W are filled in by the container)
-- ============================================================
local function buildToggle(parent, o)
    local flag = o.Flag or o.Text
    local state = o.Default and true or false

    local row = new("TextButton", {
        Position = UDim2.new(0, s(o.X), 0, s(o.Y)), Size = UDim2.new(0, s(o.W), 0, s(15)),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
    }, parent)
    local box = new("Frame", {
        Position = UDim2.new(0, 0, 0, s(3)), Size = UDim2.new(0, s(8), 0, s(8)),
        BorderSizePixel = 0,
    }, row)
    stroke(box, "BoxStroke")
    label(row, o.Text, 13, -1, o.W - 13, 15)   -- -1 offset: centred next to the box

    local function paint() box.BackgroundColor3 = state and C.Accent or C.Field end
    onTheme(paint)

    local function set(v, silent)
        state = v and true or false
        Flags[flag] = state
        paint()
        if not silent and o.Callback then pcall(o.Callback, state) end
    end
    Flags[flag] = state
    row.MouseButton1Click:Connect(function() set(not state) end)

    return register(flag, { Set = function(_, v) set(v) end, Get = function() return state end })
end

local function buildButton(parent, o)
    local b = darkBox(parent, o.X, o.Y, o.W, 15, "TextButton", nil, false)
    local bStroke = b:FindFirstChildOfClass("UIStroke")
    label(b, o.Text, 0, 0, o.W, 15, Enum.TextXAlignment.Center)

    local hovered, down, blockedPress = false, false, false
    local function paint()
        b.BackgroundColor3 = down and C.ButtonDown or (hovered and C.ButtonHover or C.Button)
        bStroke.Color = down and C.Accent or C.BoxStroke
    end
    onTheme(paint)

    b.MouseEnter:Connect(function()
        if Active then return end
        hovered = true; paint()
    end)
    b.MouseLeave:Connect(function() hovered, down = false, false; paint() end)
    b.MouseButton1Down:Connect(function()
        blockedPress = Active ~= nil
        if blockedPress then return end
        down = true; paint()
    end)
    b.MouseButton1Up:Connect(function() down = false; paint() end)
    b.MouseButton1Click:Connect(function()
        if blockedPress then blockedPress = false; return end
        if o.Callback then pcall(o.Callback) end
    end)
    return { Click = function() if o.Callback then pcall(o.Callback) end end }
end

local function buildLabel(parent, o)
    local l = label(parent, o.Text, o.X, o.Y, o.W, 12)
    return { SetText = function(_, t) l.Text = t end }
end

local function buildSlider(parent, o)
    local min, max = o.Min or 0, o.Max or 100
    local inc = o.Increment or 1
    local suffix = o.Suffix or ""
    local flag = o.Flag or o.Text
    local decimals = #(tostring(inc):match("%.(%d+)") or "")
    local fmt = "%." .. decimals .. "f"

    label(parent, o.Text, o.X, o.Y, o.W - 60, 12)
    local valLbl = label(parent, "", o.X + o.W - 60, o.Y, 60, 12, Enum.TextXAlignment.Right, false)

    local bar = darkBox(parent, o.X, o.Y + 14, o.W, 10)
    local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 }, bar)

    local hit = new("TextButton", {
        Position = UDim2.new(0, s(o.X), 0, s(o.Y)), Size = UDim2.new(0, s(o.W), 0, s(26)),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 2,
    }, parent)

    local value = min
    local dragging, hovering, dragInput, fine = false, false, nil, nil

    local function fillColor()
        return dragging and C.AccentLight or (hovering and C.AccentHover or C.Accent)
    end
    local function paint(animate)
        if animate then tween(fill, { BackgroundColor3 = fillColor() }, 0.08)
        else fill.BackgroundColor3 = fillColor() end
        valLbl.TextColor3 = dragging and C.AccentLight or C.Text
    end
    onTheme(function() paint(false) end)

    local function snap(v)
        v = math.clamp(v, min, max)
        v = math.floor((v - min) / inc + 0.5) * inc + min
        return tonumber(string.format(fmt, math.clamp(v, min, max)))
    end

    local function set(v, silent)
        value = snap(v)
        Flags[flag] = value
        fill.Size = UDim2.new((value - min) / math.max(max - min, 1e-9), 0, 1, 0)
        valLbl.Text = string.format(fmt, value) .. suffix
        if not silent and o.Callback then pcall(o.Callback, value) end
    end

    local function pointerX()
        if dragInput and dragInput.UserInputType == Enum.UserInputType.Touch then
            return dragInput.Position.X
        end
        return UserInputService:GetMouseLocation().X
    end

    local function stepDrag()
        local x = pointerX()
        local width = math.max(bar.AbsoluteSize.X, 1)
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
            if not fine then fine = { x = x, v = value } end
            set(fine.v + (x - fine.x) / width * (max - min) * 0.2)
        else
            fine = nil
            set(min + (max - min) * math.clamp((x - bar.AbsolutePosition.X) / width, 0, 1))
        end
    end

    local function stop()
        dragging, dragInput, fine = false, nil, nil
        paint(true)
    end

    set(o.Default or min, true)

    hit.InputBegan:Connect(function(input)
        if Active then return end
        if isPress(input) then
            dragging, dragInput, fine = true, input, nil
            paint(true)
            stepDrag()
        end
    end)
    hit.MouseEnter:Connect(function() if Active then return end; hovering = true; paint(true) end)
    hit.MouseLeave:Connect(function() hovering = false; paint(true) end)

    track(UserInputService.InputEnded:Connect(function(input)
        if dragging and isPress(input) then stop() end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if hovering and not dragging and input.UserInputType == Enum.UserInputType.MouseWheel then
            set(value + input.Position.Z * inc)
        end
    end))
    track(RunService.RenderStepped:Connect(function()
        if not dragging then return end
        if dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            stop()
            return
        end
        stepDrag()
    end))

    return register(flag, { Set = function(_, v) set(v) end, Get = function() return value end })
end

local function buildDropdown(parent, o)
    local w = o.W
    local flag = o.Flag or o.Text
    local options = o.Options or {}
    local current = nil
    local isOpen, hovered = false, false
    local optLabels, optRows = {}, {}

    label(parent, o.Text, o.X, o.Y, w, 12)

    local box = darkBox(parent, o.X, o.Y + 14, w, ROW_H, "TextButton", 40, false)
    local valueLbl = label(box, "", 6, 0, w - 24, ROW_H)
    local setArrow = makeArrow(box)
    setArrow(true)

    local list = new("ScrollingFrame", {
        Position = UDim2.new(0, 0, 1, s(2)), Size = UDim2.new(1, 0, 0, 0),
        BorderSizePixel = 0, Visible = false, ZIndex = 10, ClipsDescendants = true, Active = true,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = s(2),
    }, box)
    stroke(list, "BoxStroke")
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)

    local function themePaint()
        box.BackgroundColor3 = hovered and C.FieldHover or C.Field
        list.BackgroundColor3 = C.FieldList
        list.ScrollBarImageColor3 = C.Accent
        for name, l in pairs(optLabels) do
            l.TextColor3 = (name == current) and C.Accent or C.Text
        end
        for _, r in pairs(optRows) do r.BackgroundColor3 = C.FieldRow end
    end
    onTheme(themePaint)

    local function set(v, silent)
        current = v
        Flags[flag] = v
        valueLbl.Text = tostring(v)
        themePaint()
        if not silent and o.Callback then pcall(o.Callback, v) end
    end

    local handle
    local function fullHeight() return math.min(#options, MAX_ROWS) * s(ROW_H) end

    local function setOpen(open)
        if open == isOpen then return end
        isOpen = open
        setArrow(not open)
        box.ZIndex = open and 85 or 40            -- above everything while open
        if open then
            list.Size = UDim2.new(1, 0, 0, fullHeight())
            list.Visible = true
            setActive(handle)
        else
            if Active == handle then Active = nil end
            list.Visible = false
        end
    end

    handle = { close = function() setOpen(false) end }
    claim(box, handle)
    claim(list, handle)

    local function build()
        for _, ch in ipairs(list:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        optLabels, optRows = {}, {}
        for i, opt in ipairs(options) do
            local b = new("TextButton", {
                LayoutOrder = i, Size = UDim2.new(1, 0, 0, s(ROW_H)),
                BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            }, list)
            claim(b, handle)
            optRows[opt] = b
            optLabels[opt] = label(b, opt, 6, 0, w - 12, ROW_H, nil, false)
            b.MouseEnter:Connect(function() b.BackgroundTransparency = 0 end)
            b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
            b.MouseButton1Click:Connect(function()
                set(opt)
                setOpen(false)
            end)
        end
        themePaint()
    end

    box.MouseEnter:Connect(function()
        if Active and Active ~= handle then return end
        hovered = true; themePaint()
    end)
    box.MouseLeave:Connect(function() hovered = false; themePaint() end)
    box.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

    build()
    set(o.Default or options[1], true)

    return register(flag, {
        Set = function(_, v) set(v) end,
        Get = function() return current end,
        SetOptions = function(_, newOptions)
            options = newOptions
            build()
            local found = false
            for _, v in ipairs(options) do if v == current then found = true end end
            if not found then set(options[1]) end
            if isOpen then list.Size = UDim2.new(1, 0, 0, fullHeight()) end
        end,
    })
end

-- scrolling list box (always visible, click an item to select it)
local function buildListBox(parent, o)
    local flag = o.Flag or o.Text
    local rowsN = o.Rows or 5
    local items = o.Items or {}
    local current = nil
    local rowBtns, rowLbls = {}, {}

    label(parent, o.Text, o.X, o.Y, o.W, 12)
    local box = darkBox(parent, o.X, o.Y + 14, o.W, rowsN * ROW_H, nil, nil, "Field")

    local scroll = new("ScrollingFrame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Active = true,
        ScrollingDirection = Enum.ScrollingDirection.Y, ScrollBarThickness = s(2),
    }, box)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, scroll)

    local function themePaint()
        scroll.ScrollBarImageColor3 = C.Accent
        for name, l in pairs(rowLbls) do
            l.TextColor3 = (name == current) and C.Accent or C.Text
        end
        for _, b in pairs(rowBtns) do b.BackgroundColor3 = C.FieldRow end
    end
    onTheme(themePaint)

    local function set(v, silent)
        local found = false
        for _, it in ipairs(items) do if it == v then found = true end end
        current = found and v or nil
        Flags[flag] = current or ""
        themePaint()
        if not silent and o.Callback then pcall(o.Callback, current) end
    end

    local function build()
        for _, ch in ipairs(scroll:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        rowBtns, rowLbls = {}, {}
        for i, it in ipairs(items) do
            local b = new("TextButton", {
                LayoutOrder = i, Size = UDim2.new(1, 0, 0, s(ROW_H)),
                BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
            }, scroll)
            rowBtns[it] = b
            rowLbls[it] = label(b, it, 6, 0, o.W - 12, ROW_H, nil, false)
            b.MouseEnter:Connect(function() b.BackgroundTransparency = 0 end)
            b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
            b.MouseButton1Click:Connect(function() set(it) end)
        end
        themePaint()
    end

    build()
    set(o.Default, true)

    return register(flag, {
        Set = function(_, v) set(v) end,
        Get = function() return current end,
        SetItems = function(_, newItems)
            items = newItems
            build()
            set(current, true)
        end,
    })
end

local function buildInput(parent, o)
    local flag = o.Flag or o.Text
    label(parent, o.Text, o.X, o.Y, o.W, 12)

    local box = darkBox(parent, o.X, o.Y + 14, o.W, 15, nil, nil, "Field")
    local boxStroke = box:FindFirstChildOfClass("UIStroke")
    local focused = false
    onTheme(function() boxStroke.Color = focused and C.Accent or C.BoxStroke end)

    local tb = new("TextBox", {
        Position = UDim2.new(0, s(5), 0, 0), Size = UDim2.new(1, -s(10), 1, 0),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        FontFace = Font_Main, TextSize = TEXT_SIZE, TextColor3 = C.Text,
        PlaceholderText = o.Placeholder or "", PlaceholderColor3 = Color3.fromRGB(105, 105, 105),
        Text = o.Default or "", ClearTextOnFocus = false, ClipsDescendants = true,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, box)
    textStroke(tb)
    bindKey(tb, "TextColor3", "Text")

    Flags[flag] = tb.Text
    tb.Focused:Connect(function()
        if Active then tb:ReleaseFocus(); return end
        focused = true
        boxStroke.Color = C.Accent
    end)
    tb.FocusLost:Connect(function(enterPressed)
        focused = false
        boxStroke.Color = C.BoxStroke
        Flags[flag] = tb.Text
        if o.Callback then pcall(o.Callback, tb.Text, enterPressed) end
    end)

    return register(flag, {
        Set = function(_, v) tb.Text = tostring(v); Flags[flag] = tb.Text end,
        Get = function() return tb.Text end,
    })
end

local function buildKeybind(parent, o)
    local flag = o.Flag or o.Text
    local key = o.Default or Enum.KeyCode.Unknown
    local listening = false

    label(parent, o.Text, o.X, o.Y, o.W - 90, 15)
    local b = new("TextButton", {
        Position = UDim2.new(0, s(o.X + o.W - 90), 0, s(o.Y)), Size = UDim2.new(0, s(90), 0, s(15)),
        BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
    }, parent)
    local lbl = label(b, "", 0, 0, 90, 15, Enum.TextXAlignment.Right)

    local function show()
        lbl.Text = (key == Enum.KeyCode.Unknown) and "[NONE]" or ("[" .. string.upper(key.Name) .. "]")
    end
    Flags[flag] = key.Name
    show()

    local blockedPress = false
    b.MouseButton1Down:Connect(function() blockedPress = Active ~= nil end)
    b.MouseButton1Click:Connect(function()
        if blockedPress then blockedPress = false; return end
        listening = true
        isListening = true
    end)

    track(UserInputService.InputBegan:Connect(function(input, gp)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                key = (input.KeyCode == Enum.KeyCode.Escape) and Enum.KeyCode.Unknown or input.KeyCode
                Flags[flag] = key.Name
                show()
                task.defer(function() isListening = false end)
                if o.Changed then pcall(o.Changed, key) end
            end
            return
        end
        if not gp and key ~= Enum.KeyCode.Unknown and input.KeyCode == key and o.Callback then
            pcall(o.Callback)
        end
    end))

    return register(flag, {
        Get = function() return key end,
        Set = function(_, v)
            if typeof(v) == "string" then v = Enum.KeyCode[v] or Enum.KeyCode.Unknown end
            key = v
            Flags[flag] = key.Name
            show()
            if o.Changed then pcall(o.Changed, key) end
        end,
    })
end

local function buildColorPicker(parent, o)
    local PW, PH = 164, 124            -- popup size (base px)
    local PADI, GAP, HUE_W = 8, 8, 9
    local flag = o.Flag or o.Text
    local color = o.Default or C.Accent
    local hue, sat, val = color:ToHSV()

    local holder = new("Frame", {
        Position = UDim2.new(0, s(o.X), 0, s(o.Y)), Size = UDim2.new(0, s(o.W), 0, s(15)),
        BackgroundTransparency = 1, ZIndex = 50,
    }, parent)
    label(holder, o.Text, 0, 0, o.W - 22, 15)

    local swatch = new("TextButton", {
        Position = UDim2.new(1, -s(16), 0, s(3)), Size = UDim2.new(0, s(16), 0, s(9)),
        BackgroundColor3 = color, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
    }, holder)
    stroke(swatch, "BoxStroke")
    swatch.InputBegan:Connect(function(input)
        if isPress(input) then calibrate(swatch, input) end
    end)

    local popup = new("TextButton", {
        Position = UDim2.new(1, -s(PW), 0, s(18)), Size = UDim2.new(0, s(PW), 0, s(PH)),
        BorderSizePixel = 0, Visible = false, ZIndex = 60, Active = true,
        Text = "", AutoButtonColor = false,
    }, holder)
    bindKey(popup, "BackgroundColor3", "PanelBot")
    stroke(popup, "BoxStroke")

    local innerH = PH - PADI * 2
    local svW = PW - PADI * 2 - GAP - HUE_W

    local sv = new("Frame", {
        Position = UDim2.new(0, s(PADI), 0, s(PADI)), Size = UDim2.new(0, s(svW), 0, s(innerH)),
        BackgroundColor3 = Color3.fromHSV(hue, 1, 1), BorderSizePixel = 0,
    }, popup)
    stroke(sv, "BoxStroke")

    local white = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, sv)
    new("UIGradient", {
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
    }, white)

    local black = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = BLACK, BorderSizePixel = 0,
    }, sv)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) }),
    }, black)

    -- marker: 2x2 white square with a 1px black UIStroke (same on both pickers)
    local function squareMarker(p)
        local m = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 2, 0, 2),
            BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3,
        }, p)
        new("UIStroke", { Color = BLACK, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, m)
        return m
    end
    local svMark = squareMarker(sv)

    local svHit = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 4,
    }, sv)

    local hueBar = new("Frame", {
        Position = UDim2.new(0, s(PADI + svW + GAP), 0, s(PADI)), Size = UDim2.new(0, s(HUE_W), 0, s(innerH)),
        BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, popup)
    stroke(hueBar, "BoxStroke")

    local keypoints = {}
    for i = 0, 6 do
        keypoints[#keypoints + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV((i / 6) % 1, 1, 1))
    end
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(keypoints) }, hueBar)
    local hueMark = squareMarker(hueBar)

    local hueHit = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 4,
    }, hueBar)

    local function apply(silent)
        color = Color3.fromHSV(hue, sat, val)
        swatch.BackgroundColor3 = color
        sv.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
        svMark.Position = UDim2.new(sat, 0, 1 - val, 0)
        hueMark.Position = UDim2.new(0.5, 0, hue, 0)
        Flags[flag] = color
        if not silent and o.Callback then pcall(o.Callback, color) end
    end
    apply(true)

    local mode, dragInput = nil, nil

    local function update()
        local px, py = pointer(dragInput)
        if mode == "sv" then
            sat = math.clamp((px - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1), 0, 1)
            val = 1 - math.clamp((py - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1), 0, 1)
        elseif mode == "hue" then
            hue = math.clamp((py - hueBar.AbsolutePosition.Y) / math.max(hueBar.AbsoluteSize.Y, 1), 0, 1)
        else
            return
        end
        apply()
    end

    svHit.InputBegan:Connect(function(input)
        if isPress(input) then mode, dragInput = "sv", input; update() end
    end)
    hueHit.InputBegan:Connect(function(input)
        if isPress(input) then mode, dragInput = "hue", input; update() end
    end)
    track(UserInputService.InputEnded:Connect(function(input)
        if mode and isPress(input) then mode, dragInput = nil, nil end
    end))
    track(RunService.RenderStepped:Connect(function()
        if not mode then return end
        if dragInput.UserInputType == Enum.UserInputType.MouseButton1
            and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            mode, dragInput = nil, nil
            return
        end
        update()
    end))

    local isOpen = false
    local handle
    local function setOpen(open)
        isOpen = open
        popup.Visible = open
        holder.ZIndex = open and 90 or 50          -- open picker draws over the pickers below it
        if not open then mode, dragInput = nil, nil end
        if open then setActive(handle) elseif Active == handle then Active = nil end
    end
    handle = { close = function() setOpen(false) end }
    claim(swatch, handle)
    claim(popup, handle)
    claim(svHit, handle)
    claim(hueHit, handle)
    swatch.MouseButton1Click:Connect(function() setOpen(not isOpen) end)

    return register(flag, {
        Get = function() return color end,
        Set = function(_, c)
            if typeof(c) == "table" then c = Color3.new(c.r or 0, c.g or 0, c.b or 0) end
            hue, sat, val = c:ToHSV()
            apply()
        end,
    })
end

-- ============================================================
-- TAB STRIP (incremental: tabs can be added one by one)
-- ============================================================
local function newTabStrip(parent, x, y, w, h, activeGetter, onSelect)
    local strip = new("Frame", {
        Position = UDim2.new(0, s(x), 0, s(y)), Size = UDim2.new(0, s(w), 0, s(h)),
        BorderSizePixel = 0,
    }, parent)
    bindKey(strip, "BackgroundColor3", "TabOff")
    local self = { Frame = strip, Buttons = {}, Selected = 0 }

    local function paint()
        for j, b in ipairs(self.Buttons) do
            -- the active tab takes the colour of the frame it sits on, so it looks connected
            b.BackgroundColor3 = (j == self.Selected) and activeGetter() or C.TabOff
        end
    end
    onTheme(paint)

    local function layout()
        local n = #self.Buttons
        for i, b in ipairs(self.Buttons) do
            b.Position = UDim2.new((i - 1) / n, 0, 0, 0)
            b.Size = UDim2.new(1 / n, 0, 1, 0)
        end
    end

    function self:Select(i)
        self.Selected = i
        paint()
        onSelect(i)
    end

    function self:Add(name)
        local b = new("TextButton", {
            BorderSizePixel = 0, AutoButtonColor = false,
            FontFace = Font_Main, Text = name, TextSize = TEXT_SIZE, TextColor3 = C.Text,
        }, strip)
        textStroke(b)
        bindKey(b, "TextColor3", "Text")
        local i = #self.Buttons + 1
        self.Buttons[i] = b
        b.MouseButton1Click:Connect(function() self:Select(i) end)
        layout()
        if i == 1 then self:Select(1) else paint() end
        return i
    end

    return self
end

-- ============================================================
-- CONTAINER (anything that can hold widgets: Section / SubTab)
-- ============================================================
local Container = {}
Container.__index = Container

local function placed(self, kind, height, o)
    if type(o) == "string" then o = { Text = o } end
    o = o or {}
    local gap = 0
    if self.Last then
        gap = (self.Last == "toggle" and kind == "toggle") and 0 or WIDGET_GAP
    end
    local y = self.Y + gap
    self.Y = y + height
    self.Last = kind

    local full = {}
    for k, v in pairs(o) do full[k] = v end
    full.Text = full.Text or full.Name or ""
    full.X, full.Y, full.W = self.X, y, self.W
    return full
end

function Container:AddToggle(o)      return buildToggle(self.Content,      placed(self, "toggle",   15, o)) end
function Container:AddButton(o)      return buildButton(self.Content,      placed(self, "button",   15, o)) end
function Container:AddLabel(o)       return buildLabel(self.Content,       placed(self, "label",    12, o)) end
function Container:AddSlider(o)      return buildSlider(self.Content,      placed(self, "slider",   24, o)) end
function Container:AddDropdown(o)    return buildDropdown(self.Content,    placed(self, "dropdown", 29, o)) end
function Container:AddInput(o)       return buildInput(self.Content,       placed(self, "input",    29, o)) end
function Container:AddKeybind(o)     return buildKeybind(self.Content,     placed(self, "keybind",  15, o)) end
function Container:AddColorPicker(o) return buildColorPicker(self.Content, placed(self, "color",    15, o)) end

function Container:AddListBox(o)
    local rows = (type(o) == "table" and o.Rows) or 5
    return buildListBox(self.Content, placed(self, "list", 14 + rows * ROW_H, o))
end

-- several buttons side by side: AddButtonRow({ {Text=, Callback=}, {Text=, Callback=} })
function Container:AddButtonRow(list)
    local p = placed(self, "button", 15, {})
    local n, gap = #list, 4
    local bw = (p.W - gap * (n - 1)) / n
    local out = {}
    for i, def in ipairs(list) do
        out[i] = buildButton(self.Content, {
            X = p.X + (i - 1) * (bw + gap), Y = p.Y, W = bw, Text = def.Text, Callback = def.Callback,
        })
    end
    return out
end

-- ---------- ready-made blocks ----------
function Container:AddUnloadButton(text)
    return self:AddButton({ Text = text or "Unload menu", Callback = function() Library:Unload() end })
end

function Container:AddMenuKeybind(text)
    return self:AddKeybind({
