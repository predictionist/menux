-- ============================================================
-- FONT (pixel Tahoma; falls back to SourceSans)
-- ============================================================
local Font_Main = Font.fromEnum(Enum.Font.SourceSans)
do
    local hasFS = isfolder and makefolder and isfile and writefile and readfile
    if hasFS and getcustomasset then
        for _, p in ipairs({ "Ketamine", "Ketamine/Assets" }) do
            if not isfolder(p) then makefolder(p) end
        end
        local ttfPath  = "Ketamine/Assets/fs-tahoma-8px.ttf"
        local fontPath = "Ketamine/Assets/fs-tahoma-8px.font"
        local url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/fs-tahoma-8px.ttf"

        local need = true
        if isfile(ttfPath) then
            local ok, size = pcall(function() return #readfile(ttfPath) end)
            if ok and size and size > 1000 then need = false end
        end
        if need then
            local ok, data = pcall(game.HttpGet, game, url)
            if ok and data and #data > 1000 then pcall(writefile, ttfPath, data) end
        end

        local okA, asset = pcall(getcustomasset, ttfPath)
        if okA and asset then
            pcall(writefile, fontPath, HttpService:JSONEncode({
                name = "FS Tahoma 8px",
                faces = {{ name = "FS Tahoma 8px", weight = 400, style = "Regular", assetId = asset }},
            }))
            local okF, f = pcall(function() return Font.new(getcustomasset(fontPath)) end)
            if okF and f then Font_Main = f end
        end
    end
end

