-- FONT (pixel Tahoma; falls back to SourceSans)
-- ============================================================
local Font_Main = Font.fromEnum(Enum.Font.SourceSans)
do
    local hasFS = isfolder and makefolder and isfile and writefile and readfile
    if hasFS and getcustomasset then
        for _, p in ipairs({ "Ketamine", "Ketamine/Assets" }) do
            if not isfolder(p) then makefolder(p) end
        end
        local ttfPath  = "Ketamine/Assets/fs-tahoma-8px.ttf"
        local fontPath = "Ketamine/Assets/fs-tahoma-8px.font"
        local url = "https://raw.githubusercontent.com/sametexe001/luas/main/fonts/fs-tahoma-8px.ttf"

        local need = true
        if isfile(ttfPath) then
            local ok, size = pcall(function() return #readfile(ttfPath) end)
            if ok and size and size > 1000 then need = false end
        end
        if need then
            local ok, data = pcall(game.HttpGet, game, url)
            if ok and data and #data > 1000 then pcall(writefile, ttfPath, data) end
        end

        local okA, asset = pcall(getcustomasset, ttfPath)
        if okA and asset then
            pcall(writefile, fontPath, HttpService:JSONEncode({
                name = "FS Tahoma 8px",
                faces = {{ name = "FS Tahoma 8px", weight = 400, style = "Regular", assetId = asset }},
            }))
            local okF, f = pcall(function() return Font.new(getcustomasset(fontPath)) end)
            if okF and f then Font_Main = f end
        end
    end
end

-- ============================================================
-- THEME  (live: SetTheme recolours every widget)
-- ============================================================
local BLACK, WHITE = Color3.new(0, 0, 0), Color3.new(1, 1, 1)

local DEFAULT_THEME = {
    Accent     = Color3.fromRGB(125, 129, 172),
    Background = Color3.fromRGB(31, 31, 31),
    Panel      = Color3.fromRGB(40, 40, 40),
    Field      = Color3.fromRGB(46, 46, 46),
    Text       = Color3.fromRGB(230, 230, 230),
    Outline    = Color3.fromRGB(6, 6, 9),
}
Library.ThemeNames = { "Accent", "Background", "Panel", "Field", "Text", "Outline" }

-- C holds the 6 base colours (Accent, WinTop, PanelTop, Field, Text, Border) + derived ones
local C = {}
local THEME_KEYS = {
    Accent = "Accent", Background = "WinTop", Panel = "PanelTop",
    Field = "Field", Text = "Text", Outline = "Border",
}

local function recompute()
    C.WinBot       = C.WinTop:Lerp(BLACK, 0.226)
    C.PanelBot     = C.PanelTop:Lerp(BLACK, 0.40)
    C.TabOff       = C.WinTop:Lerp(BLACK, 0.387)
    C.BoxOff       = C.WinTop:Lerp(BLACK, 0.42)
    C.BoxStroke    = C.Border
    C.AccentLight  = C.Accent:Lerp(WHITE, 0.25)
    C.AccentHover  = C.Accent:Lerp(WHITE, 0.12)
    C.AccentDim    = C.Accent:Lerp(BLACK, 0.14)
    C.Button       = C.Field:Lerp(BLACK, 0.30)
    C.ButtonHover  = C.Field:Lerp(BLACK, 0.09)
    C.ButtonDown   = C.Field:Lerp(BLACK, 0.52)
    C.FieldHover   = C.Field:Lerp(WHITE, 0.05)
    C.FieldList    = C.Field:Lerp(BLACK, 0.13)
    C.FieldRow     = C.Field:Lerp(WHITE, 0.04)
end

local function resetTheme(overrides)
    for name, key in pairs(THEME_KEYS) do
        C[key] = (overrides and overrides[name]) or DEFAULT_THEME[name]
    end
    recompute()
end
resetTheme()

local Binds = {}                       -- functions that (re)apply theme colours
local function onTheme(fn) Binds[#Binds + 1] = fn; fn(); return fn end
local function bindKey(obj, prop, key) onTheme(function() obj[prop] = C[key] end) end
local function applyTheme() for _, fn in ipairs(Binds) do pcall(fn) end end

function Library:SetTheme(name, color)
    local key = THEME_KEYS[name]
    if not key or typeof(color) ~= "Color3" then return end
    C[key] = color
    recompute()
    applyTheme()
end

function Library:GetTheme(name)
    local key = THEME_KEYS[name]
    return key and C[key]
end

