local Section = setmetatable({}, { __index = Container })
Section.__index = Section

function Section:AddSubTab(name)
    if not self.Strip then
        self.Title.Visible = false
        self.Strip = newTabStrip(self.Panel, 0, 3, self.PanelW, 21,
            function() return C.PanelTop:Lerp(C.PanelBot, 13.5 / self.PanelH) end,
            function(i)
                for j, pg in ipairs(self.Pages) do pg.Visible = (j == i) end
            end)
    end

    local page = new("Frame", {
        Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Visible = false,
    }, self.Panel)
    self.Pages[#self.Pages + 1] = page
    self.Strip:Add(name)

    return setmetatable({
        Content = page, X = PAD, W = self.PanelW - PAD * 2, Y = 32, Last = nil,
    }, Container)
end

