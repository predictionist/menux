-- TAB
-- ============================================================
local Tab = {}
Tab.__index = Tab

function Tab:AddSection(name, side, height)
    side = side or ((self.Used.Left == PANEL_Y) and "Left" or "Right")
    local left = (string.lower(side) == "left")
    local key = left and "Left" or "Right"
    local x, w = left and LEFT_X or RIGHT_X, left and LEFT_W or RIGHT_W
    local y = self.Used[key]
    local h = height or (PANEL_Y + PANEL_H - y)
    self.Used[key] = y + h + 8

    local panel = makePanel(self.Page, x, y, w, h)
    local title = label(panel, name or "Section", 9, 7, w - 18, 12)

    return setmetatable({
        Panel = panel, Title = title, PanelW = w, PanelH = h, Pages = {},
        Content = panel, X = PAD, W = w - PAD * 2, Y = 24, Last = nil,
    }, Section)
end

