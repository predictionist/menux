local THEME_LABELS = {
    Accent = "Accent color", Background = "Background", Panel = "Panel",
    Field = "Field", Text = "Text", Outline = "Outline",
}

function Container:AddThemePickers(names)
    local out = {}
    for _, name in ipairs(names or Library.ThemeNames) do
        out[name] = self:AddColorPicker({
            Text = THEME_LABELS[name] or name, Flag = "theme_" .. string.lower(name),
            Default = Library:GetTheme(name),
            Callback = function(c) Library:SetTheme(name, c) end,
        })
    end
    return out
end

function Container:AddConfigSystem()
    local nameInput = self:AddInput({ Text = "Config name", Flag = "__cfg_name", Placeholder = "type a name..." })
    local list = self:AddListBox({ Text = "Configs", Flag = "__cfg_list", Items = Library:ListConfigs(), Rows = 5 })
    local status

    local function say(msg) if status then status:SetText(msg) end end
    local function refresh(select)
        list:SetItems(Library:ListConfigs())
        if select then list:Set(select) end
    end
    local function selected()
        local n = list:Get()
        if not n or n == "" then say("select a config first") return nil end
        return n
    end

    self:AddButtonRow({
        { Text = "Create", Callback = function()
            local n = (nameInput:Get():gsub("[^%w%-_ ]", "")):match("^%s*(.-)%s*$")
            if n == "" then say("type a name first") return end
            if Library:SaveConfig(n) then refresh(n); say("created " .. n) else say("could not save") end
        end },
        { Text = "Load", Callback = function()
            local n = selected(); if not n then return end
            say(Library:LoadConfig(n) and ("loaded " .. n) or "could not load")
        end },
    })
    self:AddButtonRow({
        { Text = "Overwrite", Callback = function()
            local n = selected(); if not n then return end
            say(Library:SaveConfig(n) and ("saved " .. n) or "could not save")
        end },
        { Text = "Delete", Callback = function()
            local n = selected(); if not n then return end
            if Library:DeleteConfig(n) then refresh(); say("deleted " .. n) else say("could not delete") end
        end },
    })
    self:AddButtonRow({
        { Text = "Refresh", Callback = function() refresh(list:Get()); say("refreshed") end },
        { Text = "Set autoload", Callback = function()
            local n = selected(); if not n then return end
            say(Library:SetAutoload(n) and ("autoload: " .. n) or "could not set autoload")
        end },
    })
    status = self:AddLabel("")
    return { Input = nameInput, List = list, Refresh = refresh }
end

