        Position = UDim2.new(0, 0, 0, 1), Size = UDim2.new(1, 0, 1, -1),
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Ambient = Color3.fromRGB(190, 190, 190), LightColor = WHITE,
        LightDirection = Vector3.new(0.3, -0.6, -1),
    }, panel)
    local cam = new("Camera", { FieldOfView = CAM_FOV }, viewport)
    viewport.CurrentCamera = cam

    local rig, rigToken = nil, 0
    local function buildRig()
        rigToken += 1
        local token = rigToken
        if rig then rig:Destroy(); rig = nil end

        local char = LocalPlayer.Character
        if not char then return end
        char:WaitForChild("HumanoidRootPart", 5)
        if token ~= rigToken then return end
        if not LocalPlayer:HasAppearanceLoaded() then
            LocalPlayer.CharacterAppearanceLoaded:Wait()
            if token ~= rigToken then return end
        end

        local was = char.Archivable
        char.Archivable = true
        local clone = char:Clone()
        char.Archivable = was
        if not clone then return end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then d:Destroy()
            elseif d:IsA("BasePart") then d.Anchored = true end
        end
        local hum = clone:FindFirstChildOfClass("Humanoid")
        if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end

        clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
        if not clone.PrimaryPart then clone:Destroy(); return end
        clone.Parent = viewport
        rig = clone
    end

    task.spawn(buildRig)
    track(LocalPlayer.CharacterAdded:Connect(function() task.spawn(buildRig) end))
    track(RunService.RenderStepped:Connect(function()
        if not root.Visible then return end
        if rig and rig.PrimaryPart then
            rig:SetPrimaryPartCFrame(CFrame.new(RIG_POS) * CFrame.Angles(0, math.rad(facing), 0))
            local boxCF, size = rig:GetBoundingBox()
            local center = boxCF.Position
            local aspect = math.max(viewport.AbsoluteSize.X, 1) / math.max(viewport.AbsoluteSize.Y, 1)
            local tanHalf = math.tan(math.rad(CAM_FOV / 2))
            local distY = (size.Y / 2) / tanHalf
            local distX = (math.max(size.X, size.Z) / 2) / (tanHalf * aspect)
            local dist = math.max(distY, distX) * FIT + size.Z / 2
            cam.CFrame = CFrame.lookAt(center + Vector3.new(0, 0, dist), center)
        end
    end))
    return preview
end

-- ------------------------------------------------------------
-- Library:CreateWindow
-- ------------------------------------------------------------
function Library:CreateWindow(cfg)
    cfg = cfg or {}
    Library:Unload()

    SCALE     = cfg.Scale or 1.25
    TEXT_BASE = cfg.TextSize or 11
    TEXT_SIZE = s(TEXT_BASE)
    resetTheme(cfg.Theme or (cfg.Accent and { Accent = cfg.Accent }) or nil)

    local existing = GuiParent:FindFirstChild(GUI_NAME)
    if existing then existing:Destroy() end

    Screen = new("ScreenGui", {
        Name = GUI_NAME, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        ResetOnSpawn = false, IgnoreGuiInset = true,
    }, GuiParent)
    startPopupWatcher()

    local W, H = s(WIN_W), s(WIN_H)
    local root = new("Frame", {
        Name = "Window", Size = UDim2.new(0, W, 0, H),
        Position = UDim2.new(0.5, -W / 2, 0.5, -H / 2),
        BackgroundColor3 = WHITE, BorderSizePixel = 0,
    }, Screen)
    gradient(root, "WinTop", "WinBot")
    stroke(root, "Border")

    -- title
    local titleLbl = label(root, "", 6, 0, 300, 22)
    titleLbl.RichText = true
    onTheme(function()
        local d = C.AccentDim
        titleLbl.Text = string.format('<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor(d.R * 255 + 0.5), math.floor(d.G * 255 + 0.5), math.floor(d.B * 255 + 0.5),
            cfg.Name or "Ketamine")
    end)

    -- outline + accent line
    local body = new("Frame", {
        Position = UDim2.new(0, s(6), 0, s(22)), Size = UDim2.new(0, s(542), 0, s(284)),
        BackgroundTransparency = 1, BorderSizePixel = 0,
    }, root)
    fadeStroke(body)
    local line = new("Frame", {
        Position = UDim2.new(0, s(6), 0, s(22)), Size = UDim2.new(0, s(542), 0, 1),
        BorderSizePixel = 0, ZIndex = 2,
    }, root)
    bindKey(line, "BackgroundColor3", "Accent")

    local self = setmetatable({
        Screen = Screen, Root = root, Tabs = {}, ToggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift,
    }, Window)

    -- main tabs sit on the window body -> the active tab = window colour at that height
    self.Strip = newTabStrip(root, 7, 25, 540, 23,
        function() return C.WinTop:Lerp(C.WinBot, 36.5 / WIN_H) end,
        function(i)
            for j, t in ipairs(self.Tabs) do t.Page.Visible = (j == i) end
        end)

    if cfg.Preview ~= false then self.Preview = buildPreview(root) end

    -- dragging (title bar)
    do
        local dragging, dragStart, startPos = false, nil, nil
        local dragArea = new("TextButton", {
            Size = UDim2.new(1, 0, 0, s(22)), BackgroundTransparency = 1, Text = "", ZIndex = 10,
        }, root)
        dragArea.InputBegan:Connect(function(input)
            if isPress(input) then
                calibrate(dragArea, input)
                dragging, dragStart, startPos = true, input.Position, root.Position
            end
        end)
        track(UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                local d = input.Position - dragStart
                root.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(input)
            if isPress(input) then dragging = false end
        end))
    end

    -- toggle key
    track(UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and not isListening and input.KeyCode == self.ToggleKey then
            self:Toggle()
        end
    end))

    WindowObj = self
    return self
end

-- ============================================================
-- UNLOAD
-- ============================================================
function Library:OnUnload(fn) UnloadCallbacks[#UnloadCallbacks + 1] = fn end

function Library:Unload()
    closeActive()
    for _, fn in ipairs(UnloadCallbacks) do pcall(fn) end
    table.clear(UnloadCallbacks)
    for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    table.clear(Conns)
    table.clear(Binds)
    if Screen then pcall(function() Screen:Destroy() end) end
    Screen, WindowObj, isListening = nil, nil, false
    table.clear(Options)
    table.clear(Flags)
end

-- ============================================================
-- CONFIGS  (<ConfigFolder>/<name>.json, autoload.txt remembers the autoload config)
-- ============================================================
local function fsReady() return writefile and readfile and isfile and isfolder and makefolder end

local function ensureFolder()
    if not fsReady() then return false end
    for _, p in ipairs({ "Ketamine", Library.ConfigFolder }) do
        if not isfolder(p) then makefolder(p) end
    end
    return true
end

local function encode(v)
    if typeof(v) == "Color3" then return { __t = "c3", r = v.R, g = v.G, b = v.B } end
    return v
end

function Library:ListConfigs()
    local out = {}
    if not (listfiles and isfolder and isfolder(Library.ConfigFolder)) then return out end
    local ok, files = pcall(listfiles, Library.ConfigFolder)
    if not ok then return out end
    for _, f in ipairs(files) do
        local name = tostring(f):match("([^/\\]+)%.json$")
        if name then out[#out + 1] = name end
    end
    table.sort(out)
    return out
end

function Library:SaveConfig(name)
    if not name or name == "" or not ensureFolder() then return false end
    local out = {}
    for flag, v in pairs(Flags) do
        if string.sub(flag, 1, 2) ~= "__" then out[flag] = encode(v) end   -- "__" flags are UI-only
    end
    return (pcall(writefile, Library.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(out)))
end

function Library:LoadConfig(name)
    if not name or not fsReady() then return false end
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
    if not ok or type(data) ~= "table" then return false end
    for flag, v in pairs(data) do
        local opt = Options[flag]
        if opt and opt.Set then
            if type(v) == "table" and v.__t == "c3" then v = Color3.new(v.r, v.g, v.b) end
            pcall(opt.Set, opt, v)
        end
    end
    return true
end

function Library:DeleteConfig(name)
    if not name or not (delfile and isfile) then return false end
    local path = Library.ConfigFolder .. "/" .. name .. ".json"
    if not isfile(path) then return false end
    return (pcall(delfile, path))
end

function Library:SetAutoload(name)
    if not name or not ensureFolder() then return false end
    return (pcall(writefile, Library.ConfigFolder .. "/autoload.txt", name))
end

function Library:LoadAutoload()
    if not fsReady() then return false end
    local path = Library.ConfigFolder .. "/autoload.txt"
    if not isfile(path) then return false end
    local ok, name = pcall(readfile, path)
    if not ok or name == "" then return false end
    return Library:LoadConfig(name)
end

return Library
